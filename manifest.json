{
  "manifest_version": 3,
  "name": "Translate Site",
  "version": "1.0",
  "description": "Quickly translate the current website using Google Translate",
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "permissions": [
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Translate Site",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg"
    }
  },
  "default_locale": "en",
  "short_name": "TransSite"
}