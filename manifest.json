{
  "manifest_version": 3,
  "name": "Translate Site",
  "version": "1.0",
  "description": "Quickly translate the current website using Google Translate",
  "icons": {
    "16": "images/icon.svg",
    "32": "images/icon.svg",
    "48": "images/icon.svg",
    "128": "images/icon.svg"
  },
  "permissions": [
    "contextMenus",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Translate Site"
  },
  "default_locale": "en",
  "short_name": "TransSite"
}